					<artifactId>maven-dependency-plugin</artifactId>
					<version>3.11.0</version>
				</plugin>
			</plugins>
		</pluginManagement>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<executions>
					<execution>
						<id>enforce-versions</id>
						<goals>
							<goal>enforce</goal>
						</goals>
						<configuration>
							<rules>
								<requireJavaVersion>
									<version>[21,)</version>
								</requireJavaVersion>
								<requireMavenVersion>
									<version>[3.9,)</version>
								</requireMavenVersion>
							</rules>
						</configuration>
					</execution>
					<execution>
						<!--
						  The Arrow module, the Flight SQL server and its JAR run on every JVM without native code: no
						  OpenSSL of netty-tcnative (TLS comes from the JDK), no native transports of Netty, no allocator
						  of Arrow on Netty (the allocator works on Unsafe), no compression codecs with native code, no C
						  interface of Arrow. The modules turn the check on with fyrql.native.skip set to false.
						-->
						<id>ban-native-libraries</id>
						<goals>
							<goal>enforce</goal>
						</goals>
						<configuration>
							<skip>${fyrql.native.skip}</skip>
							<rules>
								<bannedDependencies>
									<excludes>
										<exclude>io.netty:netty-tcnative*</exclude>
										<exclude>io.netty:netty-transport-native-*</exclude>
										<exclude>io.netty:netty-resolver-dns-native-*</exclude>
										<exclude>io.netty:netty-incubator-*</exclude>
										<exclude>io.grpc:grpc-netty-shaded</exclude>
										<exclude>org.apache.arrow:arrow-c-data</exclude>
										<exclude>org.apache.arrow:arrow-dataset</exclude>
										<exclude>org.apache.arrow:arrow-gandiva</exclude>
										<exclude>org.apache.arrow:arrow-compression</exclude>
										<exclude>org.apache.arrow:arrow-memory-netty*</exclude>
										<exclude>com.github.luben:zstd-jni</exclude>
										<exclude>org.lz4:lz4-java</exclude>
										<exclude>at.yawk.lz4:lz4-java</exclude>
										<exclude>org.xerial.snappy:snappy-java</exclude>
									</excludes>
									<includes>
										<!-- Classes only without a classifier; the TLS handler of Netty 4.2 needs them. -->
										<include>io.netty:netty-transport-native-unix-common:*:jar:*</include>
									</includes>
								</bannedDependencies>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
