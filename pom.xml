	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<maven.compiler.release>21</maven.compiler.release>

		<!-- Every module sets its automatic module name, which is its main package. -->
		<fyrql.module.name>net.fyrql</fyrql.module.name>

		<junit.version>6.1.3</junit.version>
		<fastcsv.version>4.4.0</fastcsv.version>
		<!-- The streaming parser of the JSON connector, and the YAML parser of the configuration file. -->
		<jackson.version>2.22.3</jackson.version>
		<jsqlparser.version>5.4</jsqlparser.version>
		<!--
		  Parquet in pure Java without Hadoop: parquet-java with the Hadoop stubs of parquet-floor; hadoop-common is only
		  needed by javac. All three are renamed into the JAR of the Parquet connector.
		-->
		<parquet.version>1.18.1</parquet.version>
		<parquet-floor.version>2.4</parquet-floor.version>
		<hadoop.version>3.5.0</hadoop.version>
		<!-- janino-lts: the latest release on Maven Central; every release of FyrQL names a fixed version. -->
		<janino.version>3.1.20</janino.version>
		<!-- The test oracle; only ever a test dependency. -->
		<duckdb.version>1.5.6.0</duckdb.version>
		<!-- JDBC drivers of the databases the JDBC connector is tested against; only ever test dependencies. -->
		<h2.version>2.5.252</h2.version>
		<sqlite-jdbc.version>3.53.4.0</sqlite-jdbc.version>
		<postgresql.version>42.7.14</postgresql.version>
		<mysql-connector-j.version>26.7.0</mysql-connector-j.version>
		<!-- Embedded databases the generic dialect is tested against. -->
		<derby.version>10.17.1.0</derby.version>
		<hsqldb.version>2.7.4</hsqldb.version>
		<!-- PostgreSQL for the tests: real binaries, unpacked and started by the build, without Docker. -->
		<embedded-postgres.version>2.2.2</embedded-postgres.version>
		<embedded-postgres-binaries.version>18.6.0</embedded-postgres-binaries.version>
		<!-- MySQL for the tests, in Docker; only started in the profile containers. -->
		<testcontainers.version>2.0.5</testcontainers.version>
		<!-- The logging of embedded-postgres and Testcontainers in the tests, which use the API 1.7. -->
		<slf4j.version>1.7.36</slf4j.version>
		<!-- The data generator of TPC-H, a port of dbgen; only ever a test dependency. -->
		<tpch.version>1.4</tpch.version>
		<!-- Apache Arrow for the Arrow module and the Flight SQL server: the latest release on Maven Central. -->
		<arrow.version>19.0.0</arrow.version>
		<!--
		  The libraries of Arrow Flight in the versions that the build of Arrow names (arrow-java-root), so that Flight
		  runs on the combination it is tested with.
		-->
		<grpc.version>1.79.0</grpc.version>
		<netty.version>4.2.9.Final</netty.version>
		<protobuf.version>4.33.4</protobuf.version>
		<guava.version>33.4.8-jre</guava.version>
		<!-- The logging API that Arrow and gRPC use; the JAR of the Flight SQL server binds it to slf4j-simple. -->
		<arrow.slf4j.version>2.0.17</arrow.slf4j.version>
		<!--
		  The memory module of Arrow reads the address of direct buffers, which the JDK opens only on request. The tests
		  run on the class path, where ALL-UNNAMED is enough; on the module path it is org.apache.arrow.memory.core.
		-->
		<arrow.add-opens>--add-opens=java.base/java.nio=ALL-UNNAMED</arrow.add-opens>
		<!--
		  Only modules that set this to false are checked for libraries with native code; the connectors of Parquet and
		  the test oracles bring such libraries along on purpose.
		-->
		<fyrql.native.skip>true</fyrql.native.skip>
	</properties>

