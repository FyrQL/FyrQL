<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>io.github.stefan-zobel</groupId>
		<artifactId>fyrql</artifactId>
		<version>0.5.0</version>
	</parent>

	<artifactId>fyrql-test</artifactId>
	<name>FyrQL tests</name>
	<description>The differential test harness against DuckDB and the tests that use it.</description>

	<properties>
		<fyrql.module.name>net.fyrql.test</fyrql.module.name>
		<!-- Whether the tests start databases in Docker; the profile containers sets it. -->
		<fyrql.test.containers>false</fyrql.test.containers>
		<!-- Where the TPC-H tests write their files, one directory per scale factor, kept from run to run. -->
		<fyrql.tpch.dir>${project.build.directory}/tpch</fyrql.tpch.dir>
	</properties>

	<dependencies>
		<dependency>
			<groupId>io.github.stefan-zobel</groupId>
			<artifactId>fyrql-engine</artifactId>
		</dependency>
		<dependency>
			<groupId>io.github.stefan-zobel</groupId>
			<artifactId>fyrql-codegen</artifactId>
		</dependency>
		<dependency>
			<groupId>io.github.stefan-zobel</groupId>
			<artifactId>fyrql-connector-memory</artifactId>
		</dependency>
		<dependency>
			<groupId>io.github.stefan-zobel</groupId>
			<artifactId>fyrql-connector-csv</artifactId>
		</dependency>
		<dependency>
			<groupId>io.github.stefan-zobel</groupId>
			<artifactId>fyrql-connector-json</artifactId>
		</dependency>
		<dependency>
			<groupId>io.github.stefan-zobel</groupId>
			<artifactId>fyrql-connector-parquet</artifactId>
		</dependency>
		<dependency>
			<groupId>io.github.stefan-zobel</groupId>
			<artifactId>fyrql-connector-http</artifactId>
		</dependency>
		<dependency>
			<groupId>io.github.stefan-zobel</groupId>
			<artifactId>fyrql-connector-odata</artifactId>
		</dependency>
		<dependency>
			<groupId>io.github.stefan-zobel</groupId>
			<artifactId>fyrql-connector-odata</artifactId>
			<type>test-jar</type>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>io.github.stefan-zobel</groupId>
			<artifactId>fyrql-connector-jdbc</artifactId>
		</dependency>
		<dependency>
			<groupId>io.github.stefan-zobel</groupId>
			<artifactId>fyrql-jdbc</artifactId>
		</dependency>
		<!--
		  Only for the order of the build: ShadedJdbcDriverTest loads the JAR in a class loader of its own, and surefire
		  leaves it off the class path of the tests.
		-->
		<dependency>
			<groupId>io.github.stefan-zobel</groupId>
			<artifactId>fyrql-jdbc-all</artifactId>
			<scope>test</scope>
			<exclusions>
				<exclusion>
					<groupId>*</groupId>
					<artifactId>*</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>org.duckdb</groupId>
			<artifactId>duckdb_jdbc</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- An unrenamed parquet-java next to the one inside the Parquet connector, for ShadedParquetTest. -->
		<dependency>
			<groupId>org.apache.parquet</groupId>
			<artifactId>parquet-column</artifactId>
			<scope>test</scope>
			<exclusions>
				<!-- The tests already have slf4j, in the version of the other test dependencies. -->
				<exclusion>
					<groupId>org.slf4j</groupId>
					<artifactId>slf4j-api</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.xerial</groupId>
			<artifactId>sqlite-jdbc</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>io.zonky.test</groupId>
			<artifactId>embedded-postgres</artifactId>
			<scope>test</scope>
		</dependency>
		<!--
		  MySQL runs in Docker, only in the profile containers; the tests are compiled in every build, so that
		  they keep up with the code.
		-->
		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-mysql</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-simple</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>io.trino.tpch</groupId>
			<artifactId>tpch</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<classpathDependencyExcludes>
						<classpathDependencyExclude>io.github.stefan-zobel:fyrql-jdbc-all</classpathDependencyExclude>
					</classpathDependencyExcludes>
					<systemPropertyVariables>
						<fyrql.test.containers>${fyrql.test.containers}</fyrql.test.containers>
						<fyrql.tpch.dir>${fyrql.tpch.dir}</fyrql.tpch.dir>
						<fyrql.jdbc.all.jar>${project.basedir}/../fyrql-jdbc-all/target/fyrql-jdbc-all-${project.version}.jar</fyrql.jdbc.all.jar>
						<org.slf4j.simpleLogger.defaultLogLevel>warn</org.slf4j.simpleLogger.defaultLogLevel>
					</systemPropertyVariables>
				</configuration>
				<executions>
					<!--
					  The tests once more with every expression, filter and key compiled from the first row on. The
					  random queries are left out: they compare both ways of running in every run.
					-->
					<execution>
						<id>codegen-always</id>
						<goals>
							<goal>test</goal>
						</goals>
						<configuration>
							<systemPropertyVariables>
								<fyrql.codegen>always</fyrql.codegen>
							</systemPropertyVariables>
							<excludes>
								<exclude>net/fyrql/test/random/**</exclude>
							</excludes>
							<reportNameSuffix>codegen</reportNameSuffix>
						</configuration>
					</execution>
					<!--
					  The tests of the connectors, the acceptance tests, TPC-H and the corpus through the JDBC driver
					  once more with pushdown off by default: every source only reads columns, and the results must
					  be the same.
					-->
					<execution>
						<id>no-pushdown</id>
						<goals>
							<goal>test</goal>
						</goals>
						<configuration>
							<systemPropertyVariables>
								<fyrql.pushdown>off</fyrql.pushdown>
							</systemPropertyVariables>
							<includes>
								<include>net/fyrql/test/connector/**</include>
								<include>net/fyrql/test/AcceptanceTest.java</include>
								<include>net/fyrql/test/tpch/**</include>
								<include>net/fyrql/test/SqlCorpusJdbcTest.java</include>
							</includes>
							<reportNameSuffix>nopushdown</reportNameSuffix>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!-- The tests against databases in Docker as well: mvn -P containers verify. -->
		<profile>
			<id>containers</id>
			<properties>
				<fyrql.test.containers>true</fyrql.test.containers>
			</properties>
		</profile>
		<!--
		  TPC-H at scale factor 1 in the interpreter with a heap of 8 GB, besides the other tests:
		  mvn -P tpch verify -Dtest=TpchScale1Test -Dsurefire.failIfNoSpecifiedTests=false runs it alone.
		-->
		<profile>
			<id>tpch</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-surefire-plugin</artifactId>
						<executions>
							<execution>
								<id>tpch-sf1</id>
								<goals>
									<goal>test</goal>
								</goals>
								<configuration>
									<argLine>-Xmx8g</argLine>
									<systemPropertyVariables>
										<fyrql.tpch.sf>1</fyrql.tpch.sf>
									</systemPropertyVariables>
									<includes>
										<include>net/fyrql/test/tpch/TpchScale1Test.java</include>
									</includes>
									<reportNameSuffix>sf1</reportNameSuffix>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
