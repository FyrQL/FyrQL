		</dependency>
		<dependency>
			<groupId>io.github.stefan-zobel</groupId>
			<artifactId>fyrql-connector-http</artifactId>
		</dependency>
		<dependency>
			<groupId>io.github.stefan-zobel</groupId>
			<artifactId>fyrql-connector-odata</artifactId>
		</dependency>
		<dependency>
			<groupId>io.github.stefan-zobel</groupId>
			<artifactId>fyrql-connector-odata</artifactId>
			<type>test-jar</type>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>io.github.stefan-zobel</groupId>
			<artifactId>fyrql-connector-s3</artifactId>
		</dependency>
		<dependency>
			<groupId>io.github.stefan-zobel</groupId>
			<artifactId>fyrql-connector-s3</artifactId>
			<type>test-jar</type>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>io.github.stefan-zobel</groupId>
			<artifactId>fyrql-connector-iceberg</artifactId>
		</dependency>
		<dependency>
			<groupId>io.github.stefan-zobel</groupId>
			<artifactId>fyrql-connector-iceberg</artifactId>
			<type>test-jar</type>
			<scope>test</scope>
		</dependency>
		<!--
		  Iceberg Java writes the Iceberg tables of the tests, see IcebergTestTables in the tests of the Iceberg
		  connector, with the same exclusions of Hadoop as there.
		-->
		<dependency>
			<groupId>org.apache.iceberg</groupId>
			<artifactId>iceberg-core</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.iceberg</groupId>
			<artifactId>iceberg-data</artifactId>
			<scope>test</scope>
			<exclusions>
				<exclusion>
					<groupId>org.apache.orc</groupId>
					<artifactId>*</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>org.apache.iceberg</groupId>
			<artifactId>iceberg-parquet</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.parquet</groupId>
			<artifactId>parquet-avro</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.parquet</groupId>
			<artifactId>parquet-hadoop</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.hadoop</groupId>
			<artifactId>hadoop-common</artifactId>
			<scope>test</scope>
			<exclusions>
				<exclusion>
					<groupId>org.eclipse.jetty</groupId>
					<artifactId>*</artifactId>
				</exclusion>
				<exclusion>
					<groupId>org.glassfish.jersey.core</groupId>
					<artifactId>*</artifactId>
				</exclusion>
				<exclusion>
					<groupId>org.glassfish.jersey.containers</groupId>
					<artifactId>*</artifactId>
				</exclusion>
				<exclusion>
					<groupId>org.glassfish.jersey.inject</groupId>
					<artifactId>*</artifactId>
				</exclusion>
				<exclusion>
					<groupId>org.glassfish.jaxb</groupId>
					<artifactId>*</artifactId>
				</exclusion>
				<exclusion>
					<groupId>jakarta.servlet.jsp</groupId>
					<artifactId>*</artifactId>
				</exclusion>
				<exclusion>
					<groupId>jakarta.ws.rs</groupId>
					<artifactId>*</artifactId>
				</exclusion>
				<exclusion>
					<groupId>javax.servlet</groupId>
					<artifactId>*</artifactId>
				</exclusion>
				<exclusion>
					<groupId>org.apache.zookeeper</groupId>
					<artifactId>*</artifactId>
				</exclusion>
				<exclusion>
					<groupId>org.apache.curator</groupId>
					<artifactId>*</artifactId>
				</exclusion>
				<exclusion>
					<groupId>org.apache.kerby</groupId>
					<artifactId>*</artifactId>
				</exclusion>
				<exclusion>
					<groupId>com.nimbusds</groupId>
					<artifactId>*</artifactId>
				</exclusion>
				<exclusion>
					<groupId>com.jcraft</groupId>
					<artifactId>*</artifactId>
				</exclusion>
				<exclusion>
					<groupId>io.netty</groupId>
					<artifactId>*</artifactId>
				</exclusion>
				<exclusion>
					<groupId>io.dropwizard.metrics</groupId>
					<artifactId>*</artifactId>
				</exclusion>
				<exclusion>
					<groupId>org.bouncycastle</groupId>
					<artifactId>*</artifactId>
				</exclusion>
				<exclusion>
					<groupId>ch.qos.reload4j</groupId>
					<artifactId>*</artifactId>
				</exclusion>
				<exclusion>
					<groupId>org.slf4j</groupId>
					<artifactId>*</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>org.apache.hadoop</groupId>
			<artifactId>hadoop-mapreduce-client-core</artifactId>
			<scope>test</scope>
			<exclusions>
				<exclusion>
					<groupId>*</groupId>
					<artifactId>*</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>io.github.stefan-zobel</groupId>
			<artifactId>fyrql-connector-jdbc</artifactId>
		</dependency>
		<dependency>
			<groupId>io.github.stefan-zobel</groupId>
			<artifactId>fyrql-jdbc</artifactId>
		</dependency>
		<dependency>
			<groupId>io.github.stefan-zobel</groupId>
			<artifactId>fyrql-jdbc</artifactId>
			<type>test-jar</type>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>io.github.stefan-zobel</groupId>
			<artifactId>fyrql-arrow</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>io.github.stefan-zobel</groupId>
			<artifactId>fyrql-flight-sql</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- The Flight SQL JDBC driver of Arrow as a client of the server; its libraries are renamed inside its JAR. -->
		<dependency>
			<groupId>org.apache.arrow</groupId>
			<artifactId>flight-sql-jdbc-driver</artifactId>
			<scope>test</scope>
		</dependency>
		<!--
		  Only for the order of the build: ShadedJdbcDriverTest loads the JAR in a class loader of its own,
		  ShadedFlightSqlServerTest starts the other in a process of its own, and surefire leaves both off the class
		  path of the tests.
		-->
		<dependency>
			<groupId>io.github.stefan-zobel</groupId>
			<artifactId>fyrql-jdbc-all</artifactId>
			<scope>test</scope>
			<exclusions>
				<exclusion>
					<groupId>*</groupId>
					<artifactId>*</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>io.github.stefan-zobel</groupId>
			<artifactId>fyrql-flight-sql-all</artifactId>
			<scope>test</scope>
			<exclusions>
				<exclusion>
					<groupId>*</groupId>
					<artifactId>*</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>org.duckdb</groupId>
			<artifactId>duckdb_jdbc</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- An unrenamed parquet-java next to the one inside the Parquet connector, for ShadedParquetTest. -->
		<dependency>
			<groupId>org.apache.parquet</groupId>
			<artifactId>parquet-column</artifactId>
			<scope>test</scope>
			<exclusions>
				<!-- The tests already have slf4j, in the version of the other test dependencies. -->
				<exclusion>
					<groupId>org.slf4j</groupId>
					<artifactId>slf4j-api</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.xerial</groupId>
			<artifactId>sqlite-jdbc</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>io.zonky.test</groupId>
			<artifactId>embedded-postgres</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Derby (with the embedded driver in derbytools) and HSQLDB, read through the generic dialect. -->
		<dependency>
			<groupId>org.apache.derby</groupId>
			<artifactId>derby</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.derby</groupId>
			<artifactId>derbytools</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.hsqldb</groupId>
			<artifactId>hsqldb</artifactId>
			<scope>test</scope>
		</dependency>
		<!--
		  MySQL runs in Docker, only in the profile containers; the tests are compiled in every build, so that
		  they keep up with the code.
		-->
		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-mysql</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-simple</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>io.trino.tpch</groupId>
			<artifactId>tpch</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<classpathDependencyExcludes>
						<classpathDependencyExclude>io.github.stefan-zobel:fyrql-jdbc-all</classpathDependencyExclude>
						<classpathDependencyExclude>io.github.stefan-zobel:fyrql-flight-sql-all</classpathDependencyExclude>
					</classpathDependencyExcludes>
					<!--
					  In UTC: the JDBC driver of DuckDB turns a TIMESTAMP WITH TIME ZONE into a Java value through the
					  time zone of the JVM and gets the instant wrong around a change of summer time.
					-->
					<argLine>${arrow.add-opens} -Duser.timezone=UTC</argLine>
					<systemPropertyVariables>
						<fyrql.test.containers>${fyrql.test.containers}</fyrql.test.containers>
						<fyrql.tpch.dir>${fyrql.tpch.dir}</fyrql.tpch.dir>
						<fyrql.jdbc.all.jar>${project.basedir}/../fyrql-jdbc-all/target/fyrql-jdbc-all-${project.version}.jar</fyrql.jdbc.all.jar>
						<fyrql.flight.all.jar>${project.basedir}/../fyrql-flight-sql-all/target/fyrql-flight-sql-all-${project.version}.jar</fyrql.flight.all.jar>
						<org.slf4j.simpleLogger.defaultLogLevel>warn</org.slf4j.simpleLogger.defaultLogLevel>
					</systemPropertyVariables>
				</configuration>
				<executions>
					<!--
					  The tests once more with every expression, filter and key compiled from the first row on. The
					  random queries are left out: they compare both ways of running in every run.
					-->
					<execution>
						<id>codegen-always</id>
						<goals>
							<goal>test</goal>
						</goals>
						<configuration>
							<skipTests>${fyrql.test.extra.skip}</skipTests>
							<systemPropertyVariables>
								<fyrql.codegen>always</fyrql.codegen>
							</systemPropertyVariables>
							<excludes>
								<exclude>net/fyrql/test/random/**</exclude>
							</excludes>
							<reportNameSuffix>codegen</reportNameSuffix>
						</configuration>
					</execution>
					<!--
					  The tests of the connectors, the acceptance tests, TPC-H and the corpus through the JDBC driver
					  once more with pushdown off by default: every source only reads columns, and the results must
					  be the same.
					-->
					<execution>
						<id>no-pushdown</id>
						<goals>
							<goal>test</goal>
						</goals>
						<configuration>
							<skipTests>${fyrql.test.extra.skip}</skipTests>
							<systemPropertyVariables>
								<fyrql.pushdown>off</fyrql.pushdown>
							</systemPropertyVariables>
							<includes>
								<include>net/fyrql/test/connector/**</include>
								<include>net/fyrql/test/AcceptanceTest.java</include>
								<include>net/fyrql/test/tpch/**</include>
								<include>net/fyrql/test/SqlCorpusJdbcTest.java</include>
							</includes>
							<reportNameSuffix>nopushdown</reportNameSuffix>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!-- The tests against databases in Docker as well: mvn -P containers verify. -->
		<profile>
			<id>containers</id>
			<properties>
				<fyrql.test.containers>true</fyrql.test.containers>
			</properties>
		</profile>
		<!--
		  TPC-H at scale factor 1 in the interpreter with a heap of 8 GB, besides the other tests:
		  mvn -P tpch verify -Dtest=TpchScale1Test -Dsurefire.failIfNoSpecifiedTests=false runs it alone.
		-->
		<profile>
			<id>tpch</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-surefire-plugin</artifactId>
						<executions>
							<execution>
								<id>tpch-sf1</id>
								<goals>
									<goal>test</goal>
								</goals>
								<configuration>
									<argLine>-Xmx8g ${arrow.add-opens} -Duser.timezone=UTC</argLine>
									<systemPropertyVariables>
										<fyrql.tpch.sf>1</fyrql.tpch.sf>
									</systemPropertyVariables>
									<includes>
										<include>net/fyrql/test/tpch/TpchScale1Test.java</include>
									</includes>
									<reportNameSuffix>sf1</reportNameSuffix>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
