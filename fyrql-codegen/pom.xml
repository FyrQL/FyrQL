<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>io.github.fyrql</groupId>
		<artifactId>fyrql</artifactId>
		<version>0.17.0</version>
	</parent>

	<artifactId>fyrql-codegen</artifactId>
	<name>FyrQL code generation</name>
	<description>Compiles expressions, filters and keys with Janino; optional, found through the ServiceLoader.</description>

	<properties>
		<fyrql.module.name>net.fyrql.codegen</fyrql.module.name>
	</properties>

	<dependencies>
		<dependency>
			<groupId>io.github.fyrql</groupId>
			<artifactId>fyrql-core</artifactId>
		</dependency>
		<dependency>
			<groupId>io.github.fyrql</groupId>
			<artifactId>fyrql-exec</artifactId>
		</dependency>
		<!--
		  Janino goes into the JAR of this module under net.fyrql.internal, so that an application may have its own
		  Janino. Optional, so that modules that depend on this one do not get the original classes as well.
		-->
		<dependency>
			<groupId>io.github.janino-lts</groupId>
			<artifactId>janino</artifactId>
			<optional>true</optional>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!--
			  The artifacts that the shade plugin below takes, for the test that the lists of third-party software
			  name their versions; the filter is the one of its artifact set.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<executions>
					<execution>
						<id>shaded-dependencies</id>
						<phase>generate-resources</phase>
						<goals>
							<goal>list</goal>
						</goals>
						<configuration>
							<includeScope>runtime</includeScope>
							<includeGroupIds>io.github.janino-lts</includeGroupIds>
							<outputFile>${project.build.directory}/shaded-dependencies.txt</outputFile>
							<sort>true</sort>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<createDependencyReducedPom>false</createDependencyReducedPom>
							<artifactSet>
								<includes>
									<include>io.github.janino-lts:*</include>
								</includes>
							</artifactSet>
							<relocations>
								<relocation>
									<pattern>org.codehaus.janino</pattern>
									<shadedPattern>net.fyrql.internal.janino</shadedPattern>
								</relocation>
								<relocation>
									<pattern>org.codehaus.commons</pattern>
									<shadedPattern>net.fyrql.internal.commons</shadedPattern>
								</relocation>
							</relocations>
							<filters>
								<filter>
									<!-- Older janino-lts JARs are signed; a relocated class no longer matches its digest. -->
									<artifact>io.github.janino-lts:*</artifact>
									<excludes>
										<exclude>META-INF/*.SF</exclude>
										<exclude>META-INF/*.DSA</exclude>
										<exclude>META-INF/*.RSA</exclude>
										<exclude>META-INF/maven/**</exclude>
									</excludes>
								</filter>
							</filters>
							<transformers>
								<!-- Renames META-INF/services/org.codehaus.commons.compiler.ICompilerFactory and its content. -->
								<transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
							</transformers>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
