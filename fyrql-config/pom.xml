<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>io.github.stefan-zobel</groupId>
		<artifactId>fyrql</artifactId>
		<version>0.4.0-SNAPSHOT</version>
	</parent>

	<artifactId>fyrql-config</artifactId>
	<name>FyrQL configuration</name>
	<description>An engine and its sources from a YAML file.</description>

	<properties>
		<fyrql.module.name>net.fyrql.config</fyrql.module.name>
	</properties>

	<dependencies>
		<dependency>
			<groupId>io.github.stefan-zobel</groupId>
			<artifactId>fyrql-engine</artifactId>
		</dependency>
		<dependency>
			<groupId>io.github.stefan-zobel</groupId>
			<artifactId>fyrql-connector-spi</artifactId>
		</dependency>
		<!-- Only the streaming parser of YAML, without data binding; the connectors are found on the class path. -->
		<dependency>
			<groupId>com.fasterxml.jackson.dataformat</groupId>
			<artifactId>jackson-dataformat-yaml</artifactId>
			<exclusions>
				<exclusion>
					<groupId>com.fasterxml.jackson.core</groupId>
					<artifactId>jackson-databind</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>io.github.stefan-zobel</groupId>
			<artifactId>fyrql-connector-csv</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>io.github.stefan-zobel</groupId>
			<artifactId>fyrql-connector-json</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>io.github.stefan-zobel</groupId>
			<artifactId>fyrql-connector-http</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>io.github.stefan-zobel</groupId>
			<artifactId>fyrql-connector-parquet</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>io.github.stefan-zobel</groupId>
			<artifactId>fyrql-connector-jdbc</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
