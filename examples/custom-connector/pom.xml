<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>net.fyrql.examples</groupId>
	<artifactId>custom-connector</artifactId>
	<version>0</version>
	<name>FyrQL example: a connector of its own</name>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<maven.compiler.release>21</maven.compiler.release>
		<fyrql.version>0.20.1</fyrql.version>
		<junit.version>6.1.3</junit.version>
	</properties>

	<dependencies>
		<!-- The SPI the connector is written against. -->
		<dependency>
			<groupId>io.github.fyrql</groupId>
			<artifactId>fyrql-connector-spi</artifactId>
			<version>${fyrql.version}</version>
		</dependency>
		<dependency>
			<groupId>io.github.fyrql</groupId>
			<artifactId>fyrql-engine</artifactId>
			<version>${fyrql.version}</version>
		</dependency>
		<!-- The configuration file that names the source. -->
		<dependency>
			<groupId>io.github.fyrql</groupId>
			<artifactId>fyrql-config</artifactId>
			<version>${fyrql.version}</version>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>${junit.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-clean-plugin</artifactId>
					<version>3.2.0</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-resources-plugin</artifactId>
					<version>3.5.0</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<version>3.16.0</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-surefire-plugin</artifactId>
					<version>3.6.0</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-jar-plugin</artifactId>
					<version>3.5.1</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-install-plugin</artifactId>
					<version>3.1.4</version>
				</plugin>
			</plugins>
		</pluginManagement>
		<plugins>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<version>3.6.3</version>
				<configuration>
					<mainClass>net.fyrql.examples.customconnector.CustomConnector</mainClass>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
